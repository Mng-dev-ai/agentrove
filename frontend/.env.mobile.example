# Mobile (iOS) build env. Copy to `.env.mobile`, then `vite --mode mobile` loads it.
# VITE_PLATFORM=mobile flips the app to thin-client mode: no local sidecar, talk
# to a remote backend over the network.
VITE_PLATFORM=mobile

# The Agentrove instance the iOS app connects to. iOS can't run the local backend
# sidecar, so point this at your own self-hosted deployment — reachable from the
# phone over https/wss (a public domain or LAN IP, never localhost).
VITE_API_BASE_URL=https://your-agentrove-instance.com/api/v1
VITE_WS_URL=wss://your-agentrove-instance.com/api/v1/ws
